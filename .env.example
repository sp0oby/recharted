# Copy to `.env` and fill in real values. Never commit `.env`.

# Required for Codex-backed OHLCV and Codex debug routes (`/api/codex`, `/api/codex-networks`, `/api/codex-test-solana`).
# Get a secret API key from https://dashboard.codex.io
CODEX_API_KEY=your-codex-api-key

# Optional / reserved — not read by the current Next.js routes (tweet fetching uses Twitter syndication without Bearer).
# TWITTER_BEARER_TOKEN=

# Optional / reserved — dependencies may exist for future integrations.
# MORALIS_API_KEY=
# COINGECKO_API_KEY=

# Optional: Apify for enhanced historical data (see package `apify-client`; wire-up may vary).
# APIFY_API_KEY=

HELIUS_API_KEY=